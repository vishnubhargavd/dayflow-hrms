datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  ADMIN
  HR
  EMPLOYEE
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_FIRST_LOGIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum EmployeeStatus {
  PROBATION
  PERMANENT
  NOTICE_PERIOD
  TERMINATED
  RESIGNED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
  LATE
  ON_LEAVE
  HOLIDAY
  WEEKEND
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveCategory {
  PAID
  UNPAID
  SICK
  CASUAL
  MATERNITY
  PATERNITY
  COMPENSATORY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum NotificationType {
  LEAVE_SUBMITTED
  LEAVE_APPROVED
  LEAVE_REJECTED
  LEAVE_CANCELLED
  HELPDESK_CREATED
  HELPDESK_ASSIGNED
  HELPDESK_UPDATED
  HELPDESK_RESOLVED
  HELPDESK_CLOSED
  ATTENDANCE_ALERT
  ATTENDANCE_CORRECTION
  PAYROLL_PROCESSED
  PAYSLIP_AVAILABLE
  SALARY_UPDATED
  PERFORMANCE_REVIEW
  GOAL_ASSIGNED
  SYSTEM_ALERT
}

enum HelpdeskCategory {
  SALARY_ISSUE
  ATTENDANCE_CORRECTION
  LEAVE_ISSUE
  DOCUMENT_REQUEST
  PROFILE_UPDATE
  OTHER
}

enum HelpdeskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum HelpdeskStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  PROCESSING
  APPROVED
  PAID
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ReviewStatus {
  DRAFT
  SELF_ASSESSMENT
  UNDER_REVIEW
  COMPLETED
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
  ON_HOLD
}

enum CandidateStatus {
  APPLIED
  SCREENING
  INTERVIEWING
  OFFERED
  HIRED
  REJECTED
}

enum SalaryComponentType {
  EARNING
  DEDUCTION
}

// ==========================================
// CORE AUTH & USER MANAGEMENT
// ==========================================

model User {
  id                     String        @id @default(uuid())
  loginId                String        @unique
  email                  String        @unique
  passwordHash           String
  role                   Role          @default(EMPLOYEE)
  accountStatus          AccountStatus @default(PENDING_FIRST_LOGIN)
  requiresPasswordChange Boolean       @default(true)
  verificationStatus     Boolean       @default(true)
  lastLoginAt            DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  employee          Employee?
  loginAttempts     LoginAttempt[]
  sessions          Session[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  uploadedDocuments Document[]
  changedSalaryHistories SalaryHistory[]
  createdPerformanceGoals PerformanceGoal[] @relation("GoalCreator")
  conductedPerformanceReviews PerformanceReview[] @relation("ReviewerUser")
  helpdeskComments HelpdeskComment[]

  @@index([loginId])
  @@index([email])
  @@index([role])
}

model LoginSequence {
  id              String   @id @default(uuid())
  companyCode     String
  year            Int
  currentSequence Int      @default(0)
  updatedAt       DateTime @updatedAt

  @@unique([companyCode, year])
}

// ==========================================
// EMPLOYEE & ORGANIZATION STRUCTURE
// ==========================================

model Department {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees    Employee[]
  designations Designation[]
}

model Designation {
  id           String      @id @default(uuid())
  title        String      @unique
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  employees Employee[]
}

model Employee {
  id             String         @id @default(uuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  loginId        String         @unique
  firstName      String
  lastName       String
  phone          String?
  personalEmail  String?
  dateOfBirth    DateTime?
  gender         Gender?
  maritalStatus  MaritalStatus?
  nationality    String?
  address        String?
  joiningYear    Int
  dateOfJoining  DateTime
  employeeStatus EmployeeStatus @default(PROBATION)
  profilePicture String?

  // Financial & Sensitive Information
  bankName      String?
  accountNumber String?
  ifscCode      String?
  panNumber     String?

  // Relational mappings
  departmentId String?
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designationId String?
  designation  Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)

  managerId String?
  manager   Employee?  @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates Employee[] @relation("EmployeeManager")

  // Related Modules
  documents              Document[]
  attendanceRecords      Attendance[]
  leaveRequests          LeaveRequest[]      @relation("LeaveRequester")
  reviewedLeaveRequests  LeaveRequest[]      @relation("LeaveReviewer")
  leaveBalances          LeaveBalance[]
  payslips               Payslip[]
  salaryStructure        SalaryStructure?
  salaryHistories        SalaryHistory[]
  payrollRecords         PayrollRecord[]
  performanceReviews     PerformanceReview[] @relation("EmployeeReviews")
  performanceGoals       PerformanceGoal[]
  assignedHelpdesk       HelpdeskRequest[]   @relation("HelpdeskAssignee")
  helpdeskRequests       HelpdeskRequest[]   @relation("HelpdeskRequester")
  onboardingTasks        OnboardingTask[]

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([loginId])
  @@index([departmentId])
  @@index([designationId])
  @@index([deletedAt])
}

model Document {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title        String
  fileUrl      String
  fileType     String
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ==========================================
// ATTENDANCE MODULE (Abhinav)
// ==========================================

model Attendance {
  id            String           @id @default(uuid())
  employeeId    String
  employee      Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date          DateTime         @db.Date
  checkIn       DateTime?
  checkOut      DateTime?
  status        AttendanceStatus @default(PRESENT)
  workHours     Float?
  overtimeHours Float?           @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  corrections AttendanceCorrection[]

  // JUSTIFIED INDEXES: Prevents duplicate attendance records and optimizes date/status lookups
  @@unique([employeeId, date])
  @@index([employeeId, date])
  @@index([date, status])
  @@index([status])
  @@index([date])
}

model AttendanceCorrection {
  id               String           @id @default(uuid())
  attendanceId     String
  attendance       Attendance       @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  requestedCheckIn DateTime?
  requestedCheckOut DateTime?
  reason           String
  status           CorrectionStatus @default(PENDING)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model WorkSchedule {
  id        String   @id @default(uuid())
  name      String
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// LEAVE & TIME OFF MODULE (Vishnu)
// ==========================================

model LeaveType {
  id             String        @id @default(uuid())
  name           String        @unique
  code           String        @unique
  category       LeaveCategory
  maxDaysPerYear Int
  description    String?
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]
}

model LeaveBalance {
  id            String    @id @default(uuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId   String
  leaveType     LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  year          Int
  allocatedDays Float
  usedDays      Float     @default(0)
  pendingDays   Float     @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([employeeId, leaveTypeId, year])
}

model LeaveRequest {
  id              String      @id @default(uuid())
  employeeId      String
  employee        Employee    @relation("LeaveRequester", fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId     String
  leaveType       LeaveType   @relation(fields: [leaveTypeId], references: [id])
  startDate       DateTime    @db.Date
  endDate         DateTime    @db.Date
  totalDays       Float
  reason          String
  status          LeaveStatus @default(PENDING)
  reviewerId      String?
  reviewer        Employee?   @relation("LeaveReviewer", fields: [reviewerId], references: [id])
  rejectionReason String?
  reviewerComment String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // JUSTIFIED INDEXES
  @@index([status])
  @@index([employeeId, createdAt])
  @@index([startDate, endDate])
  @@index([leaveTypeId])
}

// ==========================================
// NOTIFICATIONS & HELPDESK MODULE (Vishnu)
// ==========================================

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String           @db.Text
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([type])
}

model HelpdeskRequest {
  id           String           @id @default(uuid())
  ticketNumber String           @unique
  employeeId   String
  employee     Employee         @relation("HelpdeskRequester", fields: [employeeId], references: [id], onDelete: Cascade)
  category     HelpdeskCategory
  subject      String
  description  String           @db.Text
  priority     HelpdeskPriority @default(MEDIUM)
  status       HelpdeskStatus   @default(OPEN)
  assignedToId String?
  assignedTo   Employee?        @relation("HelpdeskAssignee", fields: [assignedToId], references: [id])
  resolution   String?          @db.Text
  resolvedAt   DateTime?
  closedAt     DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  comments HelpdeskComment[]

  @@index([status])
  @@index([employeeId, createdAt])
  @@index([category])
  @@index([priority])
  @@index([assignedToId])
}

model HelpdeskComment {
  id                String          @id @default(uuid())
  helpdeskRequestId String
  helpdeskRequest   HelpdeskRequest @relation(fields: [helpdeskRequestId], references: [id], onDelete: Cascade)
  authorId          String
  author            User            @relation(fields: [authorId], references: [id])
  message           String          @db.Text
  createdAt         DateTime        @default(now())

  @@index([helpdeskRequestId, createdAt])
}

// ==========================================
// ==========================================
// ==========================================
// PAYROLL MODULE (Joshith)
// ==========================================

model SalaryComponent {
  id          String              @id @default(uuid())
  name        String              @unique
  type        SalaryComponentType
  description String?
  isTaxable   Boolean             @default(true)
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  salaryStructureItems SalaryStructureItem[]
}

model SalaryStructure {
  id            String    @id @default(uuid())
  employeeId    String    @unique
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  baseSalary    Float
  effectiveDate DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items SalaryStructureItem[]

  @@index([employeeId])
}

model SalaryStructureItem {
  id                String          @id @default(uuid())
  salaryStructureId String
  salaryStructure   SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)
  salaryComponentId String
  salaryComponent   SalaryComponent @relation(fields: [salaryComponentId], references: [id], onDelete: Cascade)
  amount            Float
  createdAt         DateTime        @default(now())

  @@unique([salaryStructureId, salaryComponentId])
}

model SalaryHistory {
  id                 String   @id @default(uuid())
  employeeId         String
  employee           Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  previousBaseSalary Float?
  newBaseSalary      Float
  previousNetSalary  Float?
  newNetSalary       Float
  effectiveDate      DateTime @default(now())
  reason             String
  changedById        String
  changedBy          User     @relation(fields: [changedById], references: [id])
  createdAt          DateTime @default(now())

  @@index([employeeId, createdAt])
}

model PayrollRecord {
  id              String        @id @default(uuid())
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month           Int
  year            Int
  baseSalary      Float
  totalEarnings   Float
  totalDeductions  Float
  grossSalary     Float
  netSalary       Float
  status          PayrollStatus @default(DRAFT)
  paymentDate     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  payslip Payslip?

  @@unique([employeeId, month, year])
  @@index([month, year])
  @@index([status])
}

model Payslip {
  id              String        @id @default(uuid())
  payrollRecordId String        @unique
  payrollRecord   PayrollRecord @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payslipNumber   String        @unique
  month           Int
  year            Int
  basicSalary     Float
  allowances      Float         @default(0)
  deductions      Float         @default(0)
  netSalary       Float
  status          PayrollStatus @default(DRAFT)
  paymentDate     DateTime?
  breakdownJson   String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([employeeId, month, year])
}

// ==========================================
// PERFORMANCE MODULE (Joshith)
// ==========================================

model PerformanceGoal {
  id          String     @id @default(uuid())
  employeeId  String
  employee    Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title       String
  description String?    @db.Text
  target      String?
  progress    Float      @default(0) // 0 to 100
  status      GoalStatus @default(NOT_STARTED)
  startDate   DateTime?
  dueDate     DateTime?  @db.Date
  createdById String
  createdBy   User       @relation("GoalCreator", fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([employeeId])
  @@index([status])
}

model PerformanceReview {
  id               String       @id @default(uuid())
  employeeId       String
  employee         Employee     @relation("EmployeeReviews", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewerId       String?
  reviewer         User?        @relation("ReviewerUser", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewPeriod     String       // e.g. "Q2 2026", "2026-H1", "Annual 2026"
  reviewDate       DateTime?
  overallRating    Float?       // Range: 1.0 - 5.0
  status           ReviewStatus @default(DRAFT)
  selfAssessment   String?      @db.Text
  reviewerFeedback String?      @db.Text
  strengths        String?      @db.Text
  improvementAreas String?      @db.Text
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([employeeId, reviewPeriod])
  @@index([employeeId])
  @@index([status])
}

// ==========================================
// RECRUITMENT & ONBOARDING (Joshith)
// ==========================================

model Job {
  id          String    @id @default(uuid())
  title       String
  department  String
  description String
  status      JobStatus @default(OPEN)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  candidates Candidate[]
}

model Candidate {
  id        String          @id @default(uuid())
  jobId     String
  job       Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name      String
  email     String
  phone     String
  resumeUrl String
  status    CandidateStatus @default(APPLIED)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model OnboardingTask {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title       String
  description String
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==========================================
// SECURITY & AUDIT (Ameer)
// ==========================================

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  details   String?  @db.Text
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

model LoginAttempt {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipAddress  String?
  successful Boolean
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([ipAddress, createdAt])
  @@index([createdAt])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}
